<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="600" Height="460" Background="Transparent" UseLayoutRounding="True" TextElement.FontFamily="Segoe UI" TextElement.Foreground="#c0caf5">
  <!-- Цвета — Tokyo Night из js/lumi-palette.sys.mjs: bg0 #16161e, bg1 #1a1b26, surface #1f2335, raised #24283b, fg #c0caf5, muted #a9b1d6, dim #565f89, accent #7aa2f7 -->
  <Grid.Resources>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#16161e"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="240"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="#7aa2f7" CornerRadius="11" Padding="24,0">
          <Border.Effect><DropShadowEffect Color="#7aa2f7" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#8fb2ff"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#6a92e7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#a9b1d6"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="140"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="Transparent" BorderBrush="#24283b" BorderThickness="1" CornerRadius="9" Padding="18,0">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1f2335"/><Setter Property="Foreground" Value="#c0caf5"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#565f89"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <TextBlock x:Name="T" Foreground="{TemplateBinding Foreground}" Padding="4,4"><ContentPresenter/></TextBlock>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#7aa2f7"/><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#a9b1d6"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="Transparent" CornerRadius="8" Margin="3">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#24283b"/><Setter Property="Foreground" Value="#c0caf5"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#c0caf5"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#565f89" Background="Transparent" VerticalAlignment="Center">
            <Path x:Name="Mark" Data="M0,5 L4,9 L11,0" Stroke="#16161e" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#7aa2f7"/><Setter TargetName="Box" Property="BorderBrush" Value="#7aa2f7"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Radio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#a9b1d6"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#565f89" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#7aa2f7" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#7aa2f7"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#c0caf5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/><Setter Property="Maximum" Value="100"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track">
          <Border Background="#24283b" CornerRadius="4"/>
          <Border x:Name="PART_Indicator" Background="#7aa2f7" CornerRadius="4" HorizontalAlignment="Left">
            <Border.Effect><DropShadowEffect Color="#7aa2f7" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
          </Border>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>

  <Border Margin="20" CornerRadius="16" Background="#1a1b26" BorderBrush="#24283b" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#7aa2f7" BlurRadius="34" ShadowDepth="0" Opacity="0.26"/></Border.Effect>
    <Grid>
      <Border CornerRadius="16" IsHitTestVisible="False">
        <Border.Background><RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.8">
          <GradientStop Color="#227aa2f7" Offset="0"/><GradientStop Color="#007aa2f7" Offset="1"/></RadialGradientBrush></Border.Background>
      </Border>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid x:Name="Header" Background="Transparent">
          <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="22" Height="22" CornerRadius="6" Background="#24283b"><TextBlock Text="L" FontFamily="Consolas" FontWeight="SemiBold" FontSize="14" Foreground="#7aa2f7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="HTitle" Margin="10,0,0,0" FontSize="12" Foreground="#565f89" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}"><Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
            <Button x:Name="BtnClose" Style="{StaticResource WinBtn}"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
          </StackPanel>
        </Grid>

        <Grid x:Name="Host" Grid.Row="1">
          <!-- Приветствие -->
          <Grid x:Name="ScWelcome" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border x:Name="WLogo" Width="68" Height="68" CornerRadius="18" Background="#24283b" HorizontalAlignment="Center">
                <Border.Effect><DropShadowEffect Color="#7aa2f7" BlurRadius="26" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                <TextBlock Text="L" FontFamily="Consolas" FontWeight="SemiBold" FontSize="40" Foreground="#7aa2f7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="WTitle" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              <TextBlock x:Name="WDesc" FontSize="14" Foreground="#a9b1d6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              <TextBlock x:Name="WStatus" FontSize="12" Foreground="#565f89" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              <Button x:Name="WPrimary" Style="{StaticResource Primary}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
              <Button x:Name="WSecondary" Style="{StaticResource Ghost}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="22,0,22,12">
              <StackPanel x:Name="WAdv" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="WAdvLabel" FontSize="12" Foreground="#565f89"/>
                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"><StackPanel x:Name="WProfiles"/></ScrollViewer>
              </StackPanel>
              <Grid>
                <Button x:Name="WAdvLink" Style="{StaticResource Link}" HorizontalAlignment="Left"/>
                <Button x:Name="WBackups" Style="{StaticResource Link}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Универсальный экран: Zen открыт, Sine, Zen не найден, готово, ошибка -->
          <Grid x:Name="ScInfo" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6">
              <Border x:Name="IIcon" Width="64" Height="64" CornerRadius="32" Background="#24283b" HorizontalAlignment="Center">
                <TextBlock x:Name="IGlyph" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="ITitle" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              <TextBlock x:Name="IText" FontSize="14" Foreground="#a9b1d6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <Button x:Name="IPrimary" Style="{StaticResource Primary}" Margin="0,22,0,0" HorizontalAlignment="Center"/>
              <Button x:Name="ISecondary" Style="{StaticResource Ghost}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
              <Button x:Name="ILink" Style="{StaticResource Link}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
              <StackPanel x:Name="IDetails" Visibility="Collapsed" Margin="0,8,0,0" Width="470">
                <TextBox x:Name="ILog" Height="120" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="#a9b1d6" Background="#1f2335" BorderBrush="#24283b" Padding="8" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <Button x:Name="ICopy" Style="{StaticResource Ghost}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Мешающие моды -->
          <Grid x:Name="ScMods" Visibility="Collapsed" Margin="44,6,44,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="MTitle" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="MText" Grid.Row="1" FontSize="14" Foreground="#a9b1d6" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <Border Grid.Row="2" Background="#1f2335" CornerRadius="12" Padding="16,8" VerticalAlignment="Top"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MList"/></ScrollViewer></Border>
            <Button x:Name="MContinue" Grid.Row="3" Style="{StaticResource Primary}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
          </Grid>

          <!-- Ход установки -->
          <Grid x:Name="ScProg" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Margin="0,0,0,20">
              <TextBlock x:Name="PTitle" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="PStep" FontSize="14" Foreground="#a9b1d6" HorizontalAlignment="Center" Margin="0,8,0,24"/>
              <ProgressBar x:Name="PBar" Style="{StaticResource Bar}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- Подтверждение поверх экрана -->
      <Grid x:Name="Overlay" Visibility="Collapsed" Background="#cc16161e">
        <Border Width="390" Background="#1f2335" BorderBrush="#24283b" BorderThickness="1" CornerRadius="14" Padding="26,22" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
          <StackPanel>
            <TextBlock x:Name="OTitle" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="OText" FontSize="13" Foreground="#a9b1d6" TextWrapping="Wrap" Margin="0,8,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ONo" Style="{StaticResource Ghost}" Margin="0,0,10,0" MinWidth="100"/>
              <Button x:Name="OYes" Style="{StaticResource Primary}" Height="34" FontSize="13" MinWidth="110"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Grid>
